# ===== TISMA OS: paquetes de la imagen (Debian trixie) =====
# Los paquetes que no existan en el repositorio se omiten con un aviso.
# Solo la BASE: lo que no todo el mundo usa (ingeniería, creación, juegos, programación…) está en
# rootfs/usr/share/tisma/perfiles/*.list y se instala al elegir el perfil en la Bienvenida (tisma-perfil), desde
# los repositorios firmados de Debian. TISMA_ISO_COMPLETA=1 lo mete todo en la ISO (instalación sin conexión).

# --- Base y sesión live ---
systemd-sysv dbus sudo locales console-setup keyboard-configuration tzdata
live-boot live-config live-config-systemd initramfs-tools
network-manager wpasupplicant iw bluez rfkill wireless-regdb
zstd lz4 curl ca-certificates gnupg pciutils usbutils lshw dmidecode
# --- Secure Boot: shim (Microsoft) + GRUB y kernel firmados por Debian; mokutil para la clave TISMA ---
shim-signed shim-helpers-amd64-signed grub-efi-amd64-signed mokutil sbsigntool linux-image-amd64
# --- Instalador gráfico ---
calamares calamares-settings-debian grub-efi-amd64-bin grub-pc-bin efibootmgr os-prober
# --- Seguridad ---
apparmor apparmor-profiles apparmor-profiles-extra apparmor-utils nftables
unattended-upgrades fwupd
# --- Rendimiento adaptativo ---
systemd-zram-generator python3 cpupower-gui
# --- Memoria y copias de seguridad ---
systemd-oomd btrfs-progs restic
# --- Salud del hardware: memtest86+ en el menú de arranque, SMART, errores de máquina ---
memtest86+ smartmontools nvme-cli rasdaemon btrfs-compsize
# --- Hora autenticada (NTS) ---
chrony
# --- Escritorio KDE Plasma 6 ---
kde-plasma-desktop sddm sddm-theme-breeze plasma-nm plasma-pa plasma-systemmonitor
konsole dolphin ark kate okular gwenview kde-spectacle kcalc
# --- Uso diario ---
bluedevil kscreen kdeconnect partitionmanager filelight kfind kwalletmanager kinfocenter kcharselect
plasma-browser-integration kde-config-sddm plasma-disks plasma-vault kdialog
libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw libreoffice-qt6
libreoffice-l10n-es libreoffice-help-es hunspell-es hyphen-es mythes-es
vlc haruna elisa ffmpeg libavcodec-extra gstreamer1.0-plugins-good gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly gstreamer1.0-libav mesa-va-drivers intel-media-va-driver vainfo
cups printer-driver-all hplip print-manager sane-utils skanpage
fonts-liberation2 fonts-dejavu fonts-crosextra-carlito fonts-crosextra-caladea fonts-noto-cjk
7zip unar
# --- Aspecto: arranque con logo, iconos y tipografía modernos ---
plymouth plymouth-themes plymouth-label papirus-icon-theme fonts-inter fonts-jetbrains-mono fonts-noto-color-emoji
# --- Más aplicaciones de uso común: vídeo, grabación, audio, descargas, PDF, escritorio remoto, cámara ---
qbittorrent pdfarranger krdc krfb kamoso kolourpaint kclock kweather
kalk font-manager
# --- Accesibilidad ---
orca kmag kmousetool
# --- Privacidad y cifrado: claves GPG con interfaz, quitar metadatos, limpiar rastros, Tor ---
kleopatra mat2 metadata-cleaner bleachbit torbrowser-launcher
# --- Diseño ---
# --- Tienda TISMA (Discover): apps de Debian, Flatpak/Flathub y firmware (fwupd); permisos de Flatpak ---
plasma-discover plasma-discover-backend-flatpak plasma-discover-backend-fwupd flatpak kde-config-flatpak
flatpak-xdg-utils xdg-desktop-portal-gtk
# --- Entornos para ejecutar casi cualquier programa ---
# AppImage (libfuse2), Java + JavaFX, .NET Framework (Mono), Node.js, Python (pip/pipx), Ruby, Qt5/Qt6/SDL
libfuse2t64 default-jre mono-runtime nodejs npm python3-pip pipx ruby qtwayland5 qt6-wayland libsdl2-2.0-0
# --- Drivers: detección de hardware, NVIDIA, impresoras y escáneres sin driver (IPP/eSCL) ---
isenkram-cli apt-file nvidia-detect dkms ipp-usb sane-airscan system-config-printer
firmware-linux-nonfree firmware-brcm80211 firmware-libertas firmware-ath9k-htc firmware-cirrus firmware-intel-sound
breeze-gtk-theme kde-config-gtk-style xdg-desktop-portal-kde
fonts-noto-core fonts-noto-color-emoji
pipewire pipewire-pulse wireplumber
# --- Gráficos y firmware ---
mesa-vulkan-drivers
vulkan-tools mesa-utils
firmware-linux-free firmware-misc-nonfree firmware-amd-graphics firmware-intel-graphics firmware-nvidia-graphics
firmware-iwlwifi firmware-realtek firmware-atheros firmware-mediatek firmware-sof-signed
intel-microcode amd64-microcode
# --- Programas de Windows: Wine + Proton (Steam) ---
# --- Steam ---
# --- Programas de Android: Waydroid (desde repo.waydro.id) ---
lxc python3-gbinder
# --- Herramientas de seguridad ---
clamav clamav-freshclam rkhunter chkrootkit lynis aide auditd usbguard
opensnitch python3-opensnitch-ui keepassxc nmap
# --- Tisma engine (laminador): dependencias de ejecución ---
libgl1 libx11-6 libxrandr2 libxinerama1 libxcursor1 libxi6 libssl3t64 unzip git
# --- Ingeniería y ciencia ---
python3-numpy python3-scipy
python3-yaml python3-pil python3-pytest
# Herramientas que TISMA Code usa con «ingenieria» (mallas, electrónica digital/analógica, optimización, informes).
# Lo pesado (OpenFOAM, ParaView, FEniCSx, Netgen, PyVista/VTK) va aparte: «centinela-apps simulacion»
# --- TISMA Code (IA local para programar) ---
# Hope (cálculo exacto de TISMA Code) usa unidades (pint), gráficos (matplotlib) y álgebra simbólica (sympy)
python3-pint python3-matplotlib python3-sympy
bubblewrap strace xvfb
# llama.cpp no está en trixie: se compila (iso/components/llama-cpp.sh) con estas dependencias
# planificadores sched_ext (iso/components/scx.sh)
# --- TISMA Asistente (voz y audio 100 % locales) ---
# (el paquete «piper» de Debian es un configurador de ratones, no la voz)
espeak-ng pipewire-bin python3-cffi
# --- TISMA Navegador, DNS cifrado con bloqueo de anuncios y VPN ---
chromium chromium-l10n chromium-sandbox dnscrypt-proxy wireguard-tools network-manager-openvpn
# --- Sandbox por app y herramientas del arnés de TISMA Code ---
xdg-dbus-proxy ripgrep universal-ctags shfmt shellcheck
build-essential git
python3-yara yara python3-pefile libnotify-bin gpgv
# Motor ML de Escudo (lightgbm y signify se instalan con iso/components/escudo-ml.sh)
python3-sklearn python3-asn1crypto python3-oscrypto python3-certvalidator python3-typing-extensions libgomp1
# Eventos del kernel (inotify) en vez de sondeo, y conexiones de red: sin ellos Escudo recorría las carpetas
# cada 5 s (CPU y disco siempre despiertos)
python3-watchdog python3-psutil libglib2.0-bin
# --- REA (análisis estático) y OpenJarvis ---
binutils python3-venv libportaudio2
glmark2-es2-wayland
