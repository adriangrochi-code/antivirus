# ===== TISMA OS: kernel de la máquina virtual de análisis de Escudo =====
# Escudo ejecuta cada programa desconocido, la primera vez, en una VM desechable. Este kernel está hecho solo
# para eso: arranca en una fracción de segundo porque trae integrado únicamente lo que esa VM usa, y nada más.
# Se suma a 10-security y 15-superficie (mismo endurecimiento que el kernel del sistema).
#
# Sin módulos: nada se puede cargar dentro de la VM (más estricto que la firma obligatoria)
# CONFIG_MODULES is not set
# Máquina «microvm» de QEMU: dispositivos virtio por MMIO, sin PCI ni BIOS emulados
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HALTPOLL_CPUIDLE=y
# Sistema de análisis: squashfs de solo lectura (el mismo de la ISO mínima) montado directamente, sin initramfs
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Carpeta compartida con la muestra (9p, como hasta ahora)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
# Lo que necesita la jaula de Escudo dentro de la VM (bubblewrap + strace) y los programas analizados
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IA32_EMULATION=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# Fuera todo lo que una VM sin pantalla, sin red y sin USB no usa (menos código = menos superficie)
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_ETHERNET is not set
# CONFIG_HID is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_NFS_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KEXEC is not set
# CONFIG_PROFILING is not set
