# ===== Centinela OS: telemetría para el ajuste adaptativo (adaptd) =====
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_PERF_EVENTS=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_SCHED_INFO=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_POWERCAP=y
CONFIG_PCI=y
CONFIG_IOSF_MBI=y
CONFIG_INTEL_RAPL=m
CONFIG_AMD_PMC=m
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_PERF_EVENTS_INTEL_RAPL=m
# eBPF + BTF: necesario para planificadores adaptativos sched_ext (scx_*)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
# Respuesta del escritorio
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_HZ_1000=y

# Registro de cuelgues del kernel que sobrevive al reinicio (systemd-pstore lo guarda en /var/lib/systemd/pstore)
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=y
# Vigilantes de hardware para reiniciar ante un cuelgue total
CONFIG_WATCHDOG=y
CONFIG_SP5100_TCO=m
CONFIG_ITCO_WDT=m
