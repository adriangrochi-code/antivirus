# ===== Centinela OS: memoria comprimida y gestión adaptativa =====
CONFIG_SWAP=y
CONFIG_MEMCG=y
# zswap: caché comprimida delante del swap en disco (adaptd la activa si hay swap en disco)
CONFIG_ZSWAP=y
# CONFIG_ZSWAP_DEFAULT_ON is not set
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSMALLOC=y
# zram: swap comprimido en RAM (usado en la ISO live y sin swap en disco)
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
# Multi-Gen LRU: mejor elección de páginas a expulsar bajo presión
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_KSM=y
# DAMON: monitorización de patrones de acceso a memoria
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_NUMA_BALANCING=y
# Prueba de memoria temprana opcional (memtest=N en el arranque): aparta las zonas con fallos
CONFIG_MEMTEST=y
