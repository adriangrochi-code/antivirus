# ===== TISMA OS: Rust en el kernel =====
# Linux sigue siendo el mismo (drivers en C, misma interfaz para los programas); se activa el soporte de Rust
# y se usan las piezas que ya están escritas en Rust. Rust impide en tiempo de compilación casi todos los
# errores de memoria (uso tras liberar, desbordamientos, carreras de datos), que son la mayoría de las CVE.
CONFIG_RUST=y
# Debian versiona los símbolos de los módulos (MODVERSIONS): con Rust se calcula desde DWARF
CONFIG_GENDWARFKSYMS=y
# Binder de Android en Rust (el que usa Android en sus kernels GKI). Lo usa Waydroid. Incluye su binderfs.
# Excluye al binder en C: los dos no pueden estar a la vez.
# CONFIG_ANDROID_BINDER_IPC is not set
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_ANDROID_BINDER_DEVICES=""
