# ===== Centinela OS: compatibilidad con programas de Windows y Android =====
# --- GPU AMD GCN 1/2 con amdgpu (Vulkan/RADV); centinela graficos decide al arrancar ---
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
# --- Windows (Wine / Proton / Steam) ---
CONFIG_IA32_EMULATION=y
# CONFIG_IA32_EMULATION_DEFAULT_DISABLED is not set
CONFIG_MODIFY_LDT_SYSCALL=y
# Primitivas de sincronización NT en el kernel: menos latencia en Proton/Wine
CONFIG_NTSYNC=m
CONFIG_FUTEX=y
# Contenedores de Steam (pressure-vessel) y Flatpak usan espacios de nombres
CONFIG_USER_NS=y
CONFIG_NAMESPACES=y
# Mandos de juego
CONFIG_INPUT_JOYDEV=m
CONFIG_HID_STEAM=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_UHID=m
# --- Android (Waydroid: contenedor LXC con Android, sin emulación de CPU) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y
CONFIG_CGROUPS=y
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_NF_NAT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
# --- VPN integrada (WireGuard) ---
CONFIG_WIREGUARD=m
CONFIG_NET_UDP_TUNNEL=m
