# ===== TISMA OS: rendimiento por vatio =====
# Solo valores por defecto: todos los drivers siguen como módulos (no se pierde compatibilidad) y nada de esto
# toca las mitigaciones de CPU ni el endurecimiento. adaptd puede cambiarlo en marcha desde sysfs.
# Sin interrupción periódica en los núcleos en reposo
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# Preempción «lazy»: casi el rendimiento de «none» en carga y la respuesta de «full» en escritorio
# (con PREEMPT_DYNAMIC se puede cambiar al arrancar: preempt=full)
CONFIG_PREEMPT_LAZY=y
# Callbacks de RCU agrupados y diferidos: muchas menos activaciones de la CPU en reposo (lo usan ChromeOS y Android)
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set
# Trabajos internos del kernel en los núcleos ya despiertos en vez de despertar otro
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# Gobernador de reposo «teo» (el único: con «menu» compilado el kernel elegiría «menu»): decide mejor el
# estado de reposo profundo en sistemas sin tick. Se puede volver a menu con cpuidle.governor=menu si se compila
CONFIG_CPU_IDLE=y
# CONFIG_CPU_IDLE_GOV_MENU is not set
CONFIG_CPU_IDLE_GOV_TEO=y
# Modelo de energía para el planificador (decide qué núcleo usar según su consumo)
CONFIG_ENERGY_MODEL=y
# AMD Zen 2+ con CPPC: amd-pstate en modo activo (EPP). Las CPU más viejas (A12 Bristol Ridge) usan acpi-cpufreq
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_X86_ACPI_CPUFREQ_CPB=y
# Discos SATA: gestión de enlace de bajo consumo (med_power_with_dipm, la que recomienda Intel y usa Fedora)
CONFIG_SATA_MOBILE_LPM_POLICY=3
# Audio HDA en reposo tras 1 s sin sonido
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=1
