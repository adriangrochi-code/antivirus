# ===== TISMA OS: superficie de ataque mínima (fijo, no depende de qué CVE estén abiertas hoy) =====
# Protocolos, clasificadores de tráfico y sistemas de archivos que un escritorio no usa y que acumulan
# escaladas de privilegios (se alcanzan desde un espacio de nombres de usuario sin privilegios, que bubblewrap,
# Flatpak y Chromium necesitan). Lo que no se compila no se puede atacar ni cargar, ni siquiera como root.
# Mismo criterio que rootfs/etc/modprobe.d/centinela-blacklist.conf (que cubre también el kernel de Debian).
# Protocolos de red
# CONFIG_SMB_SERVER is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_HSR is not set
# CONFIG_PHONET is not set
# CONFIG_CAIF is not set
# CONFIG_AF_KCM is not set
# CONFIG_SMC is not set
# CONFIG_QRTR is not set
# CONFIG_ATM is not set
# CONFIG_ATALK is not set
# CONFIG_X25 is not set
# CONFIG_HAMRADIO is not set
# CONFIG_IP_SCTP is not set
# CONFIG_MPTCP is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_CAN is not set
# Control de tráfico de routers (se mantienen fq, fq_codel, cake, htb, tbf, ingress y prio)
# CONFIG_NET_CLS_U32 is not set
# CONFIG_NET_CLS_FW is not set
# CONFIG_NET_CLS_FLOW is not set
# CONFIG_NET_CLS_ROUTE4 is not set
# CONFIG_NET_CLS_BASIC is not set
# CONFIG_NET_CLS_FLOWER is not set
# CONFIG_NET_ACT_PEDIT is not set
# CONFIG_NET_ACT_CT is not set
# CONFIG_NET_ACT_SKBEDIT is not set
# CONFIG_NET_ACT_VLAN is not set
# CONFIG_NET_ACT_TUNNEL_KEY is not set
# CONFIG_NET_ACT_NAT is not set
# CONFIG_NET_ACT_MIRRED is not set
# CONFIG_NET_SCH_QFQ is not set
# CONFIG_NET_SCH_HFSC is not set
# CONFIG_NET_SCH_TAPRIO is not set
# CONFIG_NET_SCH_ETS is not set
# CONFIG_NET_SCH_DRR is not set
# CONFIG_NET_SCH_MULTIQ is not set
# CONFIG_NET_SCH_CHOKE is not set
# CONFIG_NET_SCH_SFB is not set
# CONFIG_NET_SCH_GRED is not set
# CONFIG_NET_SCH_TEQL is not set
# CONFIG_NET_SCH_CBS is not set
# CONFIG_NET_SCH_PLUG is not set
# Sistemas de archivos de clúster o en desuso
# CONFIG_OCFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_BEFS_FS is not set
# CONFIG_QNX4FS_FS is not set
# CONFIG_QNX6FS_FS is not set
# CONFIG_UFS_FS is not set
# CONFIG_OMFS_FS is not set
# CONFIG_ADFS_FS is not set
# CONFIG_AFFS_FS is not set
# CONFIG_EFS_FS is not set
# CONFIG_CRAMFS is not set
# CONFIG_VXFS_FS is not set
