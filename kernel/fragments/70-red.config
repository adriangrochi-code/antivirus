# ===== TISMA OS: red =====
# Integrados (no módulos): el kernel a medida con localmodconfig podría dejarlos fuera si no estaban
# cargados al medir, y el sysctl de 55-tisma-red.conf dejaría de surtir efecto.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
