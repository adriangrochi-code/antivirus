[Unit]
Description=TISMA - actualizar listas de bloqueo de anuncios y rastreadores
After=network-online.target dnscrypt-proxy.service
Wants=network-online.target

[Service]
Slice=tisma-segundo-plano.slice
Type=oneshot
ExecStart=/usr/lib/tisma/actualizar-bloqueo
ExecStartPost=-/usr/bin/systemctl try-restart dnscrypt-proxy.service
ProtectSystem=strict
ReadWritePaths=/var/lib/tisma-dns
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
# AF_UNIX: «systemctl try-restart» habla con systemd por un socket local
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DynamicUser=no
