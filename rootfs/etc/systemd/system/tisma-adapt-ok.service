[Unit]
Description=TISMA adapt: el arranque llegó a 3 minutos sin colgarse (el contador vuelve a cero)
ConditionPathExists=!/run/live

[Service]
Type=oneshot
ExecStart=/usr/bin/centinela adapt arranque-ok
# Si el perfil quedó suspendido, un aviso (una vez) con botón para volver a usarlo
ExecStartPost=-/usr/bin/centinela adapt avisar
ProtectHome=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/centinela -/run/escudo
ProtectSystem=strict
