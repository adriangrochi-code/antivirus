[Unit]
Description=TISMA - trabajo en segundo plano (copias, precarga, comprobaciones)
Documentation=man:systemd.resource-control(5)
Before=slices.target

[Slice]
# El escritorio y las apps tienen prioridad: este trabajo solo usa lo que sobra.
# «idle» (cgroup v2, equivale a SCHED_IDLE): solo usa CPU cuando nadie más la necesita; ni un ciclo
# robado a lo que estás haciendo. El disco sigue con peso bajo.
CPUWeight=idle
IOWeight=20
