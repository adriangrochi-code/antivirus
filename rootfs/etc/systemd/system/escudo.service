[Unit]
Description=Escudo - antivirus en tiempo real e IPS de red
After=network-online.target nftables.service
Wants=nftables.service

[Service]
Type=simple
ExecStart=/usr/bin/escudo protect /home /tmp /var/tmp
Restart=on-failure
RestartSec=5
Environment=ESCUDO_HOME=/var/lib/escudo
ProtectSystem=strict
ReadWritePaths=/var/lib/escudo /home /tmp /var/tmp
PrivateTmp=no
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYSLOG
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
