[Unit]
Description=Escudo - antivirus, vigilante de comportamiento e IPS de red
After=network-online.target nftables.service auditd.service
Wants=nftables.service auditd.service
# Si se recarga el firewall, Escudo se reinicia y reinstala los bloqueos guardados
PartOf=nftables.service

[Service]
# Despertares agrupados con los de otros procesos: la CPU duerme más tiempo seguido
TimerSlackNSec=50ms
Type=simple
ExecStartPre=-/usr/lib/escudo/audit-usuarios
ExecStart=/usr/bin/escudo protect /home /tmp /var/tmp
Restart=on-failure
RestartSec=5
Environment=ESCUDO_HOME=/var/lib/escudo
RuntimeDirectory=escudo
RuntimeDirectoryMode=0755
# Se conserva entre reinicios: los notificadores de las sesiones vigilan esta carpeta con inotify
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/escudo /home /tmp /var/tmp
PrivateTmp=no
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# KILL: congelar ransomware · AUDIT_*: reglas y registro de auditd · NET_ADMIN: nftables
# SYS_ADMIN: fanotify (puerta de primera ejecución y análisis en tiempo real); sin ella fanotify_init da EPERM
# y ambas quedaban apagadas en el sistema instalado
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_SYSLOG CAP_KILL CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=tisma-fase2.target
