[Unit]
Description=TISMA - /home, /var y /boot sin setuid ni dispositivos
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
ConditionKernelCommandLine=!boot=live

[Service]
Type=oneshot
ExecStart=/usr/lib/tisma/montajes-seguros
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
