[Unit]
Description=TISMA - sesión del USB: instalador sin contraseña y sin bloqueo de pantalla
ConditionKernelCommandLine=boot=live
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service polkit.service

[Service]
Type=oneshot
# La regla se crea en la memoria del USB live (nunca en el sistema instalado: el instalador copia la imagen, no la
# sesión). En la sesión live el usuario «tisma» ya es administrador sin contraseña: no da ningún permiso nuevo.
ExecStart=/usr/lib/tisma/sesion-live
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
