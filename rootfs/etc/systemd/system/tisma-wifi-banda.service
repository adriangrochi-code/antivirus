[Unit]
Description=TISMA - cambio rápido entre 2,4 GHz y 5 GHz
After=NetworkManager.service
ConditionPathExistsGlob=/sys/class/net/*/wireless

[Service]
# Despertares agrupados con los de otros procesos: la CPU duerme más tiempo seguido
TimerSlackNSec=50ms
ExecStart=/usr/lib/tisma/wifi-banda
Restart=on-failure
RestartSec=10
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# iw (netlink), wpa_cli (socket local) y nmcli (D-Bus)
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
MemoryMax=64M

[Install]
WantedBy=tisma-fase2.target
