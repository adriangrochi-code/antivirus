<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
"http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<!-- TISMA: menú de inicio con pocas categorías claras (antes eran 12, con «Desarrollo», «Ayuda» o «Waydroid»).
     Ciencia va dentro de Educación; Gráficos, dentro de Multimedia; Sistema, Utilidades y Desarrollo, en
     «Herramientas». Lo técnico va a «Avanzado»; todo sigue apareciendo al buscar. -->
<Menu>
	<Name>Applications</Name>
	<Menu>
		<Name>Education</Name>
		<Include><Category>Science</Category></Include>
		<Exclude><Category>X-TISMA-Avanzado</Category></Exclude>
	</Menu>
	<Menu>
		<Name>Multimedia</Name>
		<Include><Category>Graphics</Category></Include>
		<Exclude><Category>X-TISMA-Avanzado</Category></Exclude>
	</Menu>
	<Menu><Name>Internet</Name><Exclude><Category>X-TISMA-Avanzado</Category></Exclude></Menu>
	<Menu><Name>Office</Name><Exclude><Category>X-TISMA-Avanzado</Category></Exclude></Menu>
	<Menu><Name>Games</Name><Exclude><Category>X-TISMA-Avanzado</Category></Exclude></Menu>
	<Menu>
		<Name>Utilities</Name>
		<Directory>tisma-herramientas.directory</Directory>
		<Include>
			<Category>System</Category>
			<Category>Settings</Category>
			<Category>Development</Category>
		</Include>
		<Exclude><Category>X-TISMA-Avanzado</Category></Exclude>
	</Menu>
	<!-- Lo que no se usa a diario (consola, particiones, cifrado, monitores…): «Opciones avanzadas», la última
	     (Kickoff aplana las subcarpetas: por eso es una categoría propia y no Herramientas > Avanzado) -->
	<Menu>
		<Name>TismaAvanzado</Name>
		<Directory>tisma-avanzado.directory</Directory>
		<Include><Category>X-TISMA-Avanzado</Category></Include>
	</Menu>
	<Menu><Name>Science</Name><Deleted/></Menu>
	<Menu><Name>Graphics</Name><Deleted/></Menu>
	<Menu><Name>System</Name><Deleted/></Menu>
	<Menu><Name>Development</Name><Deleted/></Menu>
	<Menu><Name>Help</Name><Deleted/></Menu>
	<Menu><Name>Waydroid</Name><Deleted/></Menu>
</Menu>
