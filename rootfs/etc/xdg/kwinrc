# TISMA Cristal: cristal desenfocado suave, transiciones cortas
[Plugins]
blurEnabled=true
contrastEnabled=true
translucencyEnabled=true
wobblywindowsEnabled=false
magiclampEnabled=false
squashEnabled=true
overviewEnabled=true
# Win+M: minimizar todas las ventanas (atajo en kglobalshortcutsrc)
minimizeallEnabled=true

[Effect-blur]
BlurStrength=12
NoiseStrength=3

[Effect-translucency]
MoveResize=85
Inactive=100
Menus=96
DropdownMenus=96
PopupMenus=96
ComboboxPopups=96

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnRight=IAX

[Windows]
# Acoplar: arrastrar una ventana al borde la ajusta a media pantalla
ElectricBorderMaximize=true
ElectricBorderTiling=true
