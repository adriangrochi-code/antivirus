# TISMA: doble clic en un programa de Windows → Escudo lo revisa y se abre aislado (tisma-abrir-windows)
[Default Applications]
application/x-ms-dos-executable=net.tisma.AbrirWindows.desktop
application/x-msdownload=net.tisma.AbrirWindows.desktop
application/vnd.microsoft.portable-executable=net.tisma.AbrirWindows.desktop
application/x-dosexec=net.tisma.AbrirWindows.desktop
application/x-msi=net.tisma.AbrirWindows.desktop
application/x-ms-installer=net.tisma.AbrirWindows.desktop
application/x-wine-extension-msp=net.tisma.AbrirWindows.desktop
# Navegador predeterminado: TISMA Navegador (Chromium aislado). Sin esto, los enlaces y el favorito «navegador»
# del menú abrían Chromium SIN aislar.
x-scheme-handler/http=net.tisma.Navegador.desktop
x-scheme-handler/https=net.tisma.Navegador.desktop
text/html=net.tisma.Navegador.desktop
application/xhtml+xml=net.tisma.Navegador.desktop
