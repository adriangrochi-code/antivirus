// Actualizaciones automáticas: además de las de seguridad (configuración de Debian), las revisiones estables
// de Debian (trixie y trixie-updates). Ahí llegan las correcciones de drivers, firmware y microcódigo.
// Antes de cada instalación se crea una instantánea del sistema (80-tisma-instantanea).
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename},label=Debian";
        "origin=Debian,codename=${distro_codename}-updates,label=Debian";
        "origin=Debian,codename=${distro_codename},label=Debian-Security";
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
// Nunca reiniciar solo: el usuario decide cuándo
Unattended-Upgrade::Automatic-Reboot "false";
