// TISMA: abrir un programa de Windows debe ser tan cómodo como en Windows. La primera vez hace falta Wine: se
// instala sin pedir contraseña, pero SOLO esta orden exacta (lista fija de paquetes firmados de Debian, sin
// argumentos del usuario), SOLO para un administrador sentado frente al equipo (sesión local y activa).
polkit.addRule(function (action, subject) {
    if (action.id == "org.tisma.perfiles" &&
        action.lookup("command_line") == "/usr/bin/tisma-perfil instalar windows" &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
