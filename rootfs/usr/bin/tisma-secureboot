#!/usr/bin/python3 -I
"""tisma-secureboot: Secure Boot y kernel TISMA.

La cadena de arranque con Secure Boot es: shim (firmado por Microsoft) → GRUB (firmado por Debian) → kernel. El
kernel firmado de Debian arranca siempre. El kernel TISMA (endurecido y ajustado a tu equipo) se firma con la
clave propia de TISMA, que el firmware no conoce: hay que registrarla UNA vez (MOK) desde MokManager.

  tisma-secureboot estado    Secure Boot, clave TISMA registrada o no, y qué kernel arrancará
  tisma-secureboot activar   prepara el registro de la clave TISMA: al reiniciar aparece MokManager («Enroll MOK»)
                             y pide la contraseña de un solo uso que se muestra aquí
  tisma-secureboot elegir    (al instalar, al arrancar y tras instalar o quitar un kernel) arranca el kernel TISMA
                             solo si es seguro hacerlo:
                             - Secure Boot desactivado, o
                             - Secure Boot activado, clave TISMA registrada y kernel TISMA firmado con ella;
                             si no, el kernel firmado de Debian (el equipo siempre arranca).
  tisma-secureboot verificar        (al instalar) comprueba que el sistema instalado arranca (menú, kernel,
                             initramfs, partición EFI), lo repara una vez si hace falta y si no, falla
  tisma-secureboot quitar-minimal   (al instalar) en un equipo real quita el kernel TISMA «minimal», que es solo
                             para máquinas virtuales: así GRUB no puede quedarse con un kernel que no arranca
"""
from __future__ import annotations

import glob
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile

# El instalador (Calamares) ejecuta esto con un PATH sin /usr/sbin: update-grub no encontraba grub-mkconfig, apt no
# podía correr los avisos de los paquetes del kernel y el error quedaba oculto (paso «-»). Resultado en la A275:
# el kernel minimal seguía primero en el menú y sin initramfs («Loading Linux …-centinela-minimal»).
os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

CERT = "/usr/share/tisma/secureboot/tisma-mok.der"
GRUB_CFG = "/etc/default/grub.d/62-tisma-kernel.cfg"
BOOT = "/boot"
GRUB_MENU = "/boot/grub/grub.cfg"
UPDATE_GRUB = "/usr/sbin/update-grub"      # ruta completa: en el entorno del instalador /usr/sbin puede no estar en PATH


def sh(argv: list[str], inp: str | None = None) -> tuple[int, str]:
    try:
        r = subprocess.run(argv, capture_output=True, text=True, input=inp, timeout=60)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def sb_enabled(run=sh) -> bool | None:
    rc, out = run(["mokutil", "--sb-state"])
    if "enabled" in out.lower() and "disabled" not in out.lower():
        return True
    if "disabled" in out.lower() or "not supported" in out.lower() or "efi variables are not supported" in out.lower():
        return False
    return None


def cert_enrolled(run=sh, cert: str = CERT) -> bool:
    if not os.path.exists(cert):
        return False
    rc, out = run(["mokutil", "--test-key", cert])
    return "already enrolled" in out.lower()


def tisma_kernels(boot: str = BOOT) -> list[str]:
    return sorted(glob.glob(f"{boot}/vmlinuz-*-centinela-*"), key=lambda p: [int(x) if x.isdigit() else x
                                                                            for x in re.split(r"(\d+)", p)])


def debian_kernels(boot: str = BOOT) -> list[str]:
    """Kernels de Debian (firmados por Debian: arrancan siempre con Secure Boot), del más viejo al más nuevo."""
    ks = [k for k in glob.glob(f"{boot}/vmlinuz-*") if "-centinela-" not in k and not k.endswith(".old")]
    return sorted(ks, key=lambda p: [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", p)])


def signed_by_tisma(kernel: str, run=sh, cert: str = CERT) -> bool:
    if not os.path.exists(cert):
        return False
    pem = cert + ".pem"
    if not os.path.exists(pem):
        rc, _ = run(["openssl", "x509", "-inform", "DER", "-in", cert, "-out", pem])
        if rc:
            return False
    rc, _ = run(["sbverify", "--cert", pem, kernel])
    return rc == 0


def in_vm(run=sh) -> bool:
    rc, out = run(["systemd-detect-virt", "--vm"])
    return rc == 0 and out.strip() not in ("", "none")


def choose(sb: bool | None, enrolled: bool, kernels: list[str], signed: dict[str, bool], vm: bool) -> str | None:
    """Kernel TISMA que debe arrancar por defecto, o None (el firmado de Debian). Lógica pura (probada)."""
    usable = [k for k in kernels if "-minimal" not in k or vm]      # el perfil minimal es solo para máquinas virtuales
    if not usable:
        return None
    k = usable[-1]
    if sb is False:
        return k
    if sb and enrolled and signed.get(k):
        return k
    return None


MODULES = "/lib/modules"
UPDATE_INITRAMFS = "/usr/sbin/update-initramfs"


def asegurar_initrd(run=sh, boot: str | None = None, modules: str | None = None) -> list[str]:
    """Crea el initramfs de cada kernel instalado que no lo tenga. Sin él el kernel no puede abrir el disco: en la A275
    (preview 19) el sistema instalado terminaba en «VFS: Unable to mount root fs … unknown-block(0,0)»."""
    boot, modules = boot or BOOT, modules or MODULES
    creados = []
    for d in sorted(glob.glob(f"{modules}/*")):
        v = os.path.basename(d)
        if os.path.exists(f"{boot}/vmlinuz-{v}") and not os.path.exists(f"{boot}/initrd.img-{v}"):
            rc, out = run([UPDATE_INITRAMFS, "-c", "-k", v])
            if rc or not os.path.exists(f"{boot}/initrd.img-{v}"):
                raise RuntimeError(f"no se pudo crear el initramfs de {v}: " + out.strip()[-300:])
            creados.append(v)
    return creados


def elegir(run=sh) -> str:
    asegurar_initrd(run)
    sb = sb_enabled(run)
    ks = tisma_kernels()
    enrolled = cert_enrolled(run) if sb else False
    k = choose(sb, enrolled, ks, {x: signed_by_tisma(x, run) for x in ks} if sb else {}, in_vm(run))
    # Siempre explícito: sin GRUB_TOP_LEVEL, GRUB arranca el kernel de versión MÁS ALTA, que suele ser el de TISMA
    # (7.3 > 7.2 de Debian): con Secure Boot y la clave sin registrar daba «bad shim signature» en el primer
    # arranque tras instalar (visto en QEMU)
    debian = debian_kernels()
    elegido = k or (debian[-1] if debian else None)
    want = (f'# Generado por tisma-secureboot elegir\nGRUB_TOP_LEVEL="{elegido}"\n') if elegido else None
    cur = open(GRUB_CFG).read() if os.path.exists(GRUB_CFG) else None
    if want != cur:
        if want:
            with open(GRUB_CFG, "w") as fh:
                fh.write(want)
        elif cur is not None:
            os.remove(GRUB_CFG)
    # El menú de GRUB se regenera si la configuración cambió O si el menú no arranca lo elegido: en la A275 (preview
    # 6) el archivo quedó bien pero el menú seguía con el kernel TISMA primero, y como la configuración ya «estaba
    # al día» nunca se volvía a generar
    # …o si la entrada por defecto no carga su initramfs: el instalador arma el menú ANTES de crearlos y, sin
    # regenerarlo, el kernel arrancaba sin poder abrir el disco
    if want != cur or (elegido and primer_kernel(GRUB_MENU) != os.path.basename(elegido)) or not primer_con_initrd(GRUB_MENU):
        regenerar_menu(run)
    return f"kernel TISMA ({os.path.basename(k)})" if k else \
        f"kernel firmado de Debian ({os.path.basename(elegido)})" if elegido else "lo que elija GRUB"


def primer_con_initrd(menu: str | None = None, boot: str | None = None) -> bool:
    """Does the default boot entry load an initramfs that exists?

    Parameters:
        menu: path of the GRUB menu (default GRUB_MENU, /boot/grub/grub.cfg).
        boot: directory that holds the kernels and initramfs images (default BOOT).

    Returns:
        True only when the menu can be read, has a «linux» entry, that entry has an «initrd» line and the file it
        names exists in `boot`.

    Why strict: an unreadable or missing menu used to count as «fine». In the A275 (preview 22) the installer's
    final check then printed «Arranque comprobado: ?» with no grub.cfg at all and the installed system ended in
    «VFS: Unable to mount root fs … unknown-block(0,0)». A menu we cannot read is a menu we cannot vouch for.
    """
    entrada = entrada_por_defecto(menu or GRUB_MENU)
    if entrada is None or entrada[1] is None:
        return False
    return os.path.exists(os.path.join(boot or BOOT, os.path.basename(entrada[1])))


def entrada_por_defecto(menu: str) -> tuple[str, str | None] | None:
    """Kernel and initramfs of the default GRUB entry (the first «linux» line of the menu).

    Parameters:
        menu: path of grub.cfg.

    Returns:
        (kernel_path, initrd_path) as written in the menu, e.g. ("/vmlinuz-7.3.4+deb13-amd64",
        "/initrd.img-7.3.4+deb13-amd64"); initrd_path is None when the entry has no «initrd» line. Returns None when
        the menu cannot be read or has no «linux» entry.

    Only the FIRST entry matters: with GRUB_TIMEOUT_STYLE=hidden it is the one that boots. Entries chosen later by
    06_tisma_fallos (tisma-seguro) are written by 42_tisma_volver only when their initramfs exists.
    """
    try:
        with open(menu, encoding="utf-8", errors="replace") as fh:
            lineas = [linea.split() for linea in fh]
    except OSError:
        return None
    for i, partes in enumerate(lineas):
        if len(partes) >= 2 and partes[0] == "linux":
            for siguiente in lineas[i + 1:]:
                if siguiente and siguiente[0] == "initrd" and len(siguiente) >= 2:
                    # «initrd /amd-ucode.img /initrd.img-…»: the system initramfs is the LAST one
                    return partes[1], siguiente[-1]
                if siguiente and siguiente[0] in ("linux", "}", "menuentry"):
                    break
            # No initrd line: the menu was generated before the initramfs existed
            return partes[1], None
    return None


def primer_kernel(menu: str = GRUB_MENU) -> str | None:
    """Kernel de la entrada por defecto del menú de GRUB (la primera «linux …»), p. ej. «vmlinuz-7.2.12+deb13-amd64»."""
    try:
        for linea in open(menu, encoding="utf-8", errors="replace"):
            partes = linea.split()
            if len(partes) >= 2 and partes[0] == "linux":
                return os.path.basename(partes[1])
    except OSError:
        pass
    return None


# =====================================================================================================================
# ===                              INSTALLER FINAL CHECK: «verificar» (check, repair, check again)                ===
# =====================================================================================================================
#
# Last step of the installer (shellprocess@tisma, WITHOUT «-»): if the installed system would not boot, the
# installer must say so instead of finishing «fine». Before failing it tries ONE repair round, because every
# problem below has a mechanical fix that is safe to run inside the installer's chroot.
#
# History (ThinkPad A275): previews 19-22 ended in «VFS: Unable to mount root fs on /dev/sda3 or
# unknown-block(0,0)», i.e. the kernel started WITHOUT an initramfs. The old check passed when grub.cfg was
# missing, so it could not catch it.

# --- Configuration ---

# Smallest initramfs accepted, in bytes. A real Debian initramfs is 30-150 MB; anything under 1 MiB is a truncated
# or empty file (a write cut short by a full /boot or a crash). Range: 256 KiB - 8 MiB. Default 1 MiB. Too high
# would reject a valid, very small «MODULES=dep» image; too low would let a broken file through.
INITRD_MIN_BYTES = 1024 * 1024

# First bytes of a valid initramfs: «070701»/«070702» = cpio (uncompressed, or the early-microcode cpio that
# precedes the compressed part), then zstd, gzip, xz, lz4 and lzma magic numbers. Anything else is not loadable.
INITRD_MAGICS = (b"070701", b"070702", b"\x28\xb5\x2f\xfd", b"\x1f\x8b", b"\xfd7zXZ", b"\x02\x21\x4c\x18",
                 b"\x5d\x00\x00")

# EFI system partition as mounted in the installed system (fstab and Calamares both use this path).
ESP = "/boot/efi"

# --- Checks ---


def problemas_de_arranque(menu: str | None = None, boot: str | None = None, esp: str | None = None,
                          uuid_de_boot=None, uuid_existe=None) -> list[str]:
    """List every reason why the installed system would not boot. Empty list = it boots.

    Parameters:
        menu: grub.cfg path (default GRUB_MENU).
        boot: /boot directory (default BOOT).
        esp: EFI system partition mount point (default ESP).
        uuid_de_boot: callable () -> str|None, filesystem UUID that holds /boot (default: grub-probe).
        uuid_existe: callable (uuid) -> bool, whether a filesystem with that UUID exists (default: blkid).

    Returns:
        Spanish messages, one per problem (they end up in the installer's error dialog, which the user reads).
    """
    menu, boot, esp = menu or GRUB_MENU, boot or BOOT, esp or ESP
    entrada = entrada_por_defecto(menu)
    if entrada is None:
        if not os.path.exists(menu):
            return [f"no existe el menú de arranque ({menu})"]
        return [f"el menú de arranque ({menu}) no tiene ninguna entrada de Linux"]
    kernel, initrd = entrada
    problemas = []
    if not os.path.exists(os.path.join(boot, os.path.basename(kernel))):
        problemas.append(f"falta el kernel {os.path.basename(kernel)} en {boot}")
    if initrd is None:
        problemas.append(f"la entrada {os.path.basename(kernel)} no carga ningún initramfs")
    else:
        problema = problema_de_initrd(os.path.join(boot, os.path.basename(initrd)))
        if problema:
            problemas.append(problema)
    problemas += stubs_efi_rotos(esp, uuid_de_boot or uuid_de_boot_real, uuid_existe or uuid_existe_real)[1]
    return problemas


def problema_de_initrd(ruta: str) -> str | None:
    """Why the initramfs at `ruta` cannot be loaded (Spanish text), or None if it looks loadable.

    Checks existence, minimum size (INITRD_MIN_BYTES) and the format's magic number (INITRD_MAGICS). It does not
    decompress it: that would take seconds and the size+magic test already catches empty and truncated files.
    """
    nombre = os.path.basename(ruta)
    try:
        tamano = os.path.getsize(ruta)
        with open(ruta, "rb") as fh:
            cabecera = fh.read(8)
    except OSError:
        return f"falta el initramfs {nombre}"
    if tamano < INITRD_MIN_BYTES:
        return f"el initramfs {nombre} está incompleto ({tamano} bytes)"
    if not cabecera.startswith(INITRD_MAGICS):
        return f"el initramfs {nombre} está dañado (formato desconocido)"
    return None


def uuid_de_boot_real() -> str | None:
    """UUID of the filesystem that holds /boot, as GRUB sees it (the value grub-install writes into the ESP stub)."""
    rc, out = sh(["grub-probe", "--target=fs_uuid", BOOT])
    return out.strip() if rc == 0 and out.strip() else None


def uuid_existe_real(uuid: str) -> bool:
    """Does any filesystem with this UUID exist on this machine? (blkid -U exits 0 only when it finds it.)"""
    rc, _ = sh(["blkid", "-U", uuid])
    return rc == 0


def stubs_efi_rotos(esp: str, uuid_de_boot, uuid_existe) -> tuple[list[str], list[str]]:
    """Find GRUB stubs on the ESP (EFI/<name>/grub.cfg) that point to a filesystem that no longer exists.

    How GRUB finds its menu with Secure Boot: shim loads Debian's signed grubx64.efi, whose built-in prefix is
    /EFI/debian. It reads ESP:/EFI/debian/grub.cfg if it exists, otherwise grub.cfg next to itself. That stub only
    says «search.fs_uuid <UUID of /boot>; configfile …/grub.cfg». A stub left by an EARLIER install (same ESP kept
    when installing over it) points to a /boot that was reformatted: GRUB then opens a stale menu or none.

    Parameters:
        esp: ESP mount point.
        uuid_de_boot: callable () -> str|None (UUID of the current /boot).
        uuid_existe: callable (uuid) -> bool.

    Returns:
        (paths_of_broken_stubs, spanish_messages). A stub pointing to ANOTHER existing filesystem is left alone:
        it may belong to another system on the same disk (dual boot).
    """
    actual = uuid_de_boot()
    rotos, mensajes = [], []
    if not actual:
        return rotos, mensajes
    for stub in sorted(glob.glob(os.path.join(esp, "EFI", "*", "grub.cfg"))):
        try:
            texto = open(stub, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for apuntado in re.findall(r"search\.fs_uuid\s+(\S+)", texto):
            if apuntado != actual and not uuid_existe(apuntado):
                rotos.append(stub)
                mensajes.append(f"{os.path.relpath(stub, esp)} apunta a un disco que ya no existe ({apuntado})")
                break
    return rotos, mensajes


# --- Repairs ---


def reparar_stubs_efi(rotos: list[str], uuid_nuevo: str) -> None:
    """Point each broken ESP stub at the current /boot (replace the stale UUID on its search.fs_uuid lines)."""
    for stub in rotos:
        texto = open(stub, encoding="utf-8", errors="replace").read()
        texto = re.sub(r"(search\.fs_uuid\s+)\S+", lambda m: m.group(1) + uuid_nuevo, texto)
        with open(stub, "w", encoding="utf-8") as fh:
            fh.write(texto)


def reponer_kernel_en_modules(boot: str | None = None, modules: str | None = None) -> list[str]:
    """Restore /usr/lib/modules/<version>/{vmlinuz,config,System.map} from /boot when they are missing.

    Why: Debian's 7.x kernel packages ship these as HARD LINKS of /boot/vmlinuz-<version> etc. With a separate
    /boot partition the installer's copy (rsync -H) cannot create a hard link across filesystems (EXDEV) and the
    copy under /usr/lib/modules is silently missing. Tools that read the kernel from there (and the next kernel
    upgrade's cleanup) then fail. A plain copy is what dpkg would have produced on separate filesystems.

    Returns:
        «<version>/<file>» for every file restored.
    """
    boot, modules = boot or BOOT, modules or MODULES
    repuestos = []
    for directorio in sorted(glob.glob(f"{modules}/*")):
        version = os.path.basename(directorio)
        for nombre in ("vmlinuz", "config", "System.map"):
            origen, destino = f"{boot}/{nombre}-{version}", f"{directorio}/{nombre}"
            if os.path.isfile(origen) and not os.path.lexists(destino):
                shutil.copy2(origen, destino)
                repuestos.append(f"{version}/{nombre}")
    return repuestos


def regenerar_menu(run=sh) -> None:
    """Rebuild grub.cfg. Waits for udev first so /dev/disk/by-uuid has the freshly formatted partitions.

    Why the wait: GRUB's 10_linux writes root=UUID=… only if /dev/disk/by-uuid/<UUID> exists; otherwise it falls
    back to root=/dev/sdX (seen in the A275 panic: «root fs on /dev/sda3»). /dev/sdX changes when a USB stick is
    plugged in, so the UUID form is the robust one. udevadm failing (no udev in a test chroot) is not an error.

    Raises:
        RuntimeError if update-grub fails (with the tail of its output).
    """
    run(["udevadm", "settle", "--timeout=10"])
    rc, out = run([UPDATE_GRUB])
    if rc:
        raise RuntimeError("update-grub falló: " + out.strip()[-300:])


def verificar(run=sh, comprobar=None) -> str:
    """Installer's final boot check: check, repair once, check again.

    Parameters:
        run: command runner (tests inject a fake).
        comprobar: callable () -> list[str] that returns the problems (default problemas_de_arranque).

    Returns:
        Spanish summary for the installer log.

    Raises:
        RuntimeError with every remaining problem when the repair did not fix them: the installer shows it and
        does NOT finish «fine» with a machine that cannot boot.
    """
    comprobar = comprobar or problemas_de_arranque
    reponer_kernel_en_modules()
    problemas = comprobar()
    if problemas:
        print("Arreglando el arranque: " + "; ".join(problemas), file=sys.stderr)
        asegurar_initrd(run)
        # An initramfs that exists but is truncated is rebuilt (asegurar_initrd only creates missing ones)
        for version in sorted(os.listdir(MODULES)) if os.path.isdir(MODULES) else []:
            ruta = f"{BOOT}/initrd.img-{version}"
            if os.path.exists(f"{BOOT}/vmlinuz-{version}") and problema_de_initrd(ruta):
                rc, out = run([UPDATE_INITRAMFS, "-c", "-k", version])
                if rc:
                    raise RuntimeError(f"no se pudo rehacer el initramfs de {version}: " + out.strip()[-300:])
        regenerar_menu(run)
        actual = uuid_de_boot_real()
        if actual:
            reparar_stubs_efi(stubs_efi_rotos(ESP, lambda: actual, uuid_existe_real)[0], actual)
        problemas = comprobar()
    # Flush /boot and the ESP to disk now: if the machine is switched off right after «Hecho», nothing is lost
    run(["sync"])
    if problemas:
        raise RuntimeError("el sistema instalado no podría arrancar: " + "; ".join(problemas))
    kernel, initrd = entrada_por_defecto(GRUB_MENU) or ("?", "?")
    return f"{os.path.basename(kernel)} con su initramfs {os.path.basename(initrd or '?')}"


def quitar_minimal(run=sh) -> str:
    """En un equipo real, desinstala el kernel TISMA «minimal» (solo sirve en máquinas virtuales)."""
    if in_vm(run):
        return "máquina virtual: se conserva el kernel TISMA minimal"
    rc, out = run(["dpkg-query", "-W", "-f", "${Package} ${db:Status-Abbrev}\n", "linux-image-*-centinela-minimal",
                   "linux-headers-*-centinela-minimal"])
    paquetes = [l.split()[0] for l in out.splitlines() if len(l.split()) == 2 and l.split()[1].startswith("ii")]
    if not paquetes:
        return "no hay kernel TISMA minimal instalado"
    rc, out = run(["apt-get", "purge", "-y", "-q", *paquetes])
    if rc:
        raise RuntimeError("no se pudo quitar el kernel minimal: " + out.strip()[-300:])
    return "quitado " + ", ".join(paquetes)


def activar(run=sh) -> int:
    if not os.path.exists(CERT):
        print("Esta instalación no trae la clave TISMA (la ISO se construyó sin firmar el kernel TISMA).")
        return 1
    if sb_enabled(run) is False:
        print("Secure Boot está desactivado: el kernel TISMA ya arranca sin registrar nada.")
        return 0
    if cert_enrolled(run):
        print("La clave TISMA ya está registrada.")
        return 0
    pw = "".join(secrets.choice("0123456789") for _ in range(8))     # números: se teclean bien en MokManager
    with tempfile.NamedTemporaryFile("w", delete=False) as fh:
        hash_file = fh.name
    try:
        rc, out = run(["mokutil", "--generate-hash=" + pw])
        if rc or not out.strip():
            print("No se pudo preparar la contraseña: " + out.strip())
            return 1
        with open(hash_file, "w") as fh:
            fh.write(out.strip() + "\n")
        rc, out = run(["mokutil", "--import", CERT, "--hash-file", hash_file])
    finally:
        os.remove(hash_file)
    if rc:
        print("mokutil no pudo preparar el registro: " + out.strip())
        return 1
    print("Listo. Al reiniciar aparecerá una pantalla azul (MokManager):\n"
          "  1. Elige «Enroll MOK» → «Continue» → «Yes».\n"
          f"  2. Escribe la contraseña: {pw}\n"
          "  3. Elige «Reboot».\n"
          "Después, TISMA arrancará con su propio kernel también con Secure Boot activado.")
    return 0


def estado(run=sh) -> int:
    sb = sb_enabled(run)
    print("Secure Boot: " + {True: "activado", False: "desactivado", None: "desconocido"}[sb])
    print("Clave TISMA: " + ("registrada" if cert_enrolled(run) else "no registrada" if os.path.exists(CERT)
                             else "no incluida en esta instalación"))
    ks = tisma_kernels()
    print("Kernel TISMA: " + (", ".join(os.path.basename(k) + (" (firmado)" if signed_by_tisma(k, run) else "")
                                        for k in ks) or "no instalado"))
    k = choose(sb, cert_enrolled(run) if sb else False, ks, {x: signed_by_tisma(x, run) for x in ks}, in_vm(run))
    print("Arrancará: " + (f"kernel TISMA ({os.path.basename(k)})" if k else "kernel firmado de Debian"))
    if sb and os.path.exists(CERT) and not cert_enrolled(run):
        print("Para usar el kernel TISMA con Secure Boot: sudo tisma-secureboot activar")
    return 0


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "estado"
    if cmd not in ("estado", "activar", "elegir", "quitar-minimal", "verificar"):
        print(__doc__)
        return 2
    if cmd != "estado" and os.geteuid() != 0:
        print(f"Necesita permisos de administrador: sudo tisma-secureboot {cmd}", file=sys.stderr)
        return 2
    try:
        if cmd == "elegir":
            print("Arrancará: " + elegir())
            return 0
        if cmd == "quitar-minimal":
            print(quitar_minimal())
            return 0
        if cmd == "verificar":
            # Last installer step: a visible error is better than a machine that does not boot
            print("Arranque comprobado: " + verificar())
            return 0
    except RuntimeError as e:
        print(f"tisma-secureboot {cmd}: {e}", file=sys.stderr)
        return 1
    return activar() if cmd == "activar" else estado()


if __name__ == "__main__" and os.environ.get("TISMA_TEST") != "1":
    sys.exit(main(sys.argv[1:]))
