#!/usr/bin/python3 -I
"""Muestra en el escritorio las alertas de Escudo (/run/escudo/alertas.jsonl).

Duerme hasta que el archivo cambia (inotify): antes comprobaba cada segundo en cada sesión de usuario, lo que
despertaba la CPU 86.400 veces al día sin ninguna alerta. Sin inotify, vuelve al sondeo.
"""
import ctypes
import json
import os
import select
import shutil
import subprocess
import time

DIR = os.environ.get("ESCUDO_ALERTAS_DIR", "/run/escudo")
PATH = DIR + "/alertas.jsonl"
ICON = {"critical": "dialog-error", "high": "security-low", "medium": "dialog-warning", "low": "dialog-information"}
TITLE = {"kernel": "Actualización de seguridad del kernel", "ransomware": "Posible ransomware detenido", "secretos": "Acceso a tus claves", "persistencia":
         "Un programa intenta iniciarse solo", "navegador_secretos": "Acceso a datos del navegador",
         "exec_tmp": "Ejecución desde carpeta temporal", "ptrace": "Intento de inyección en otro proceso",
         "modulos": "Módulo del kernel cargado", "ldpreload": "Modificación de ld.so.preload"}
IN_MODIFY, IN_MOVED_TO, IN_CREATE = 0x2, 0x80, 0x100
IN_NONBLOCK, IN_CLOEXEC = 0o4000, 0o2000000


def inotify(path: str):
    """Descriptor que se vuelve legible cuando algo cambia en la carpeta, o None."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        fd = libc.inotify_init1(IN_NONBLOCK | IN_CLOEXEC)
        if fd < 0:
            return None
        if libc.inotify_add_watch(fd, path.encode(), IN_MODIFY | IN_MOVED_TO | IN_CREATE) < 0:
            os.close(fd)
            return None
        # También la carpeta padre: si Escudo recrea la suya, el aviso llega al momento (la vigilancia anterior
        # se queda en la carpeta vieja)
        libc.inotify_add_watch(fd, os.path.dirname(path.rstrip("/")).encode() or b"/", IN_CREATE | IN_MOVED_TO)
        return fd
    except (OSError, AttributeError):
        return None


def notify(line: str) -> None:
    try:
        a = json.loads(line)
    except ValueError:
        return
    urgency = "critical" if a.get("severity") in ("critical", "high") else "normal"
    body = f"{a.get('detail', '')}\n{a.get('action', '')}"[:400]
    subprocess.run(["notify-send", "-a", "Escudo", "-u", urgency, "-i", ICON.get(a.get("severity"), "security-medium"),
                    TITLE.get(a.get("kind"), "Escudo"), body], check=False)


def ident(path: str):
    try:
        st = os.stat(path)
        return (st.st_dev, st.st_ino)
    except OSError:
        return None


def main():
    if not shutil.which("notify-send"):
        return
    while not os.path.isdir(DIR):
        time.sleep(30)                                  # Escudo aún no ha arrancado
    fd, dir_id = inotify(DIR), ident(DIR)
    file_id = ident(PATH)
    pos = os.path.getsize(PATH) if file_id else 0       # solo lo nuevo desde que se abre la sesión
    while True:
        # Carpeta recreada (reinicio de Escudo): la vigilancia anterior ya no avisa → se vuelve a crear
        if ident(DIR) != dir_id and os.path.isdir(DIR):
            if fd is not None:
                os.close(fd)
            fd, dir_id = inotify(DIR), ident(DIR)
        cur = ident(PATH)
        if cur != file_id:
            file_id, pos = cur, 0                       # archivo nuevo: desde el principio
        try:
            size = os.path.getsize(PATH)
        except OSError:
            size = 0
        if size < pos:
            pos = 0                                     # truncado
        if size > pos:
            with open(PATH, "rb") as fh:
                fh.seek(pos)
                for raw in fh:
                    if not raw.endswith(b"\n"):
                        break                           # línea a medio escribir: se lee en el próximo aviso
                    notify(raw.decode("utf-8", "replace"))
                    pos += len(raw)
        if fd is None:
            time.sleep(2)
            fd = inotify(DIR) if os.path.isdir(DIR) else None
            continue
        select.select([fd], [], [], 30)
        try:
            while os.read(fd, 4096):                    # vaciar los eventos acumulados
                pass
        except BlockingIOError:
            pass


main()
