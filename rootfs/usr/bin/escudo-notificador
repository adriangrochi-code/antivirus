#!/usr/bin/python3 -I
"""Muestra en el escritorio las alertas de Escudo (/run/escudo/alertas.jsonl).

Duerme hasta que el archivo cambia (inotify): antes comprobaba cada segundo en cada sesión de usuario, lo que
despertaba la CPU 86.400 veces al día sin ninguna alerta. Sin inotify, vuelve al sondeo.
"""
import ctypes
import json
import os
import re
import select
import shutil
import subprocess
import threading
import time

DIR = os.environ.get("ESCUDO_ALERTAS_DIR", "/run/escudo")
PATH = DIR + "/alertas.jsonl"
ICON = {"info": "security-high", "critical": "dialog-error", "high": "security-low", "medium": "dialog-warning", "low": "dialog-information"}
TITLE = {"calor": "El equipo se calienta", "disco": "Salud del disco", "hardware": "Salud del equipo", "sistema": "Salud del sistema", "kernel_listo": "Actualización instalada", "teclado_falso": "USB falso bloqueado", "primera_ejecucion": "Revisión de un programa nuevo", "kernel": "Actualización de seguridad del kernel", "ransomware": "Posible ransomware detenido", "secretos": "Acceso a tus claves", "persistencia":
         "Un programa intenta iniciarse solo", "navegador_secretos": "Acceso a datos del navegador",
         "exec_tmp": "Ejecución desde carpeta temporal", "ptrace": "Intento de inyección en otro proceso",
         "modulos": "Módulo del kernel cargado", "ldpreload": "Modificación de ld.so.preload"}
IN_MODIFY, IN_MOVED_TO, IN_CREATE = 0x2, 0x80, 0x100
IN_NONBLOCK, IN_CLOEXEC = 0o4000, 0o2000000


def inotify(path: str):
    """Descriptor que se vuelve legible cuando algo cambia en la carpeta, o None."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        fd = libc.inotify_init1(IN_NONBLOCK | IN_CLOEXEC)
        if fd < 0:
            return None
        if libc.inotify_add_watch(fd, path.encode(), IN_MODIFY | IN_MOVED_TO | IN_CREATE) < 0:
            os.close(fd)
            return None
        # También la carpeta padre: si Escudo recrea la suya, el aviso llega al momento (la vigilancia anterior
        # se queda en la carpeta vieja)
        libc.inotify_add_watch(fd, os.path.dirname(path.rstrip("/")).encode() or b"/", IN_CREATE | IN_MOVED_TO)
        return fd
    except (OSError, AttributeError):
        return None


def _permitir(a: dict) -> list[str] | None:
    exe = a.get("exe")
    if not isinstance(exe, str) or not os.path.isabs(exe) or not os.path.isfile(exe) or "\n" in exe:
        return None
    return ["pkexec", "/usr/bin/escudo", "permitir", exe]


# Botones de las notificaciones: SOLO estas acciones, con su orden armada aquí (nunca texto de la alerta).
# pkexec pide la contraseña de administrador con la ventana del sistema: nada de terminal.
ACCIONES = {
    # Sin administrador ni datos de la alerta: solo abre TISMA Seguridad (sección «Programas revisados»)
    "ver_informe": ("Ver informe", lambda a: ["/usr/bin/tisma-seguridad-panel"], None, None),
    "permitir": ("Permitir", _permitir, "Listo: ya puedes abrirlo con normalidad.",
                 "No se pudo permitir (hacen falta permisos de administrador)."),
    "permitir_teclado": ("Era mío", lambda a: ["pkexec", "/usr/bin/escudo", "teclado", "permitir", a["exe"]]
                         if isinstance(a.get("exe"), str) and re.fullmatch(r"[0-9a-f]{4}:[0-9a-f]{4}(:[\w.-]{0,64})?",
                                                                          a["exe"]) else None,
                         "Listo: ese dispositivo ya puede usarse. Si no responde, desconéctalo y vuelve a conectarlo.",
                         "No se pudo permitir (hacen falta permisos de administrador)."),
    "actualizar_kernel": ("Actualizar ahora", lambda a: ["pkexec", "/usr/bin/centinela", "build-kernel", "--install"],
                          "Actualización del kernel preparada: se usará al reiniciar el equipo.",
                          "No se pudo actualizar el kernel. Se volverá a intentar más tarde."),
}


def _con_boton(a: dict, base: list[str], titulo: str, body: str, run=subprocess.run) -> None:
    """Notificación con botón: espera a que se pulse (en su propio hilo) y entonces hace la acción."""
    etiqueta, orden, ok_txt, mal_txt = ACCIONES[a["boton"]]
    argv = orden(a)
    if not argv:
        run(base + [titulo, body], check=False)
        return
    r = run(base + ["--action", f"{a['boton']}={etiqueta}", "--wait", titulo, body], capture_output=True,
            text=True, check=False)
    if (r.stdout or "").strip() != a["boton"]:
        return                                         # cerrada o ignorada: no se hace nada
    hecho = run(argv, check=False).returncode == 0
    if ok_txt is None:
        return                                         # abrir una ventana: no hace falta otro aviso
    run(["notify-send", "-a", "Escudo", "-i", "security-high" if hecho else "dialog-warning", titulo,
         ok_txt if hecho else mal_txt], check=False)


# Textos para cualquier persona: sin rutas, nombres de procesos ni órdenes. El detalle técnico queda en el registro
# de Escudo y en TISMA Seguridad.
SIMPLE = {
    "navegador_secretos": "{programa} intentó leer las sesiones o contraseñas guardadas del navegador. Si no lo "
                          "abriste tú, revisa el equipo en TISMA Seguridad.",
    "secretos": "{programa} intentó leer tus claves privadas. Si no lo abriste tú, revisa el equipo en "
                "TISMA Seguridad.",
    "persistencia": "{programa} intentó quedar configurado para abrirse solo al encender el equipo.",
    "exec_tmp": "Se abrió {programa} desde una carpeta de descargas o temporal.",
    "ptrace": "{programa} intentó meterse en otro programa abierto.",
    "modulos": "Se cargó una pieza nueva en el núcleo del sistema.",
    "ldpreload": "Un programa intentó cambiar cómo se abren todos los demás.",
}
INTERPRETES = re.compile(r"^(python|perl|ruby|node|bash|sh|dash|java)[\d.]*$")


def programa(exe) -> str:
    """Nombre corto para la persona: «Un programa» si es un intérprete (no dice nada útil) o no se sabe."""
    nombre = os.path.basename(exe) if isinstance(exe, str) else ""
    return f"«{nombre}»" if nombre and not INTERPRETES.match(nombre) else "Un programa"


def cuerpo(a: dict) -> str:
    plantilla = SIMPLE.get(a.get("kind"))
    if plantilla:
        texto = plantilla.format(programa=programa(a.get("exe")))
        return texto[0].upper() + texto[1:]
    return f"{a.get('detail', '')}\n{a.get('action', '')}".strip()


def notify(line: str, run=subprocess.run) -> threading.Thread | None:
    try:
        a = json.loads(line)
    except ValueError:
        return None
    urgency = "critical" if a.get("severity") in ("critical", "high") else "normal"
    body = cuerpo(a)[:400]
    titulo = TITLE.get(a.get("kind"), "Escudo")
    base = ["notify-send", "-a", "Escudo", "-u", urgency, "-i", ICON.get(a.get("severity"), "security-medium")]
    if a.get("boton") in ACCIONES:
        t = threading.Thread(target=_con_boton, args=(a, base, titulo, body, run), daemon=True)
        t.start()
        return t
    run(base + [titulo, body], check=False)
    return None


def ident(path: str):
    try:
        st = os.stat(path)
        return (st.st_dev, st.st_ino)
    except OSError:
        return None


def main():
    if not shutil.which("notify-send"):
        return
    while not os.path.isdir(DIR):
        time.sleep(30)                                  # Escudo aún no ha arrancado
    fd, dir_id = inotify(DIR), ident(DIR)
    file_id = ident(PATH)
    pos = os.path.getsize(PATH) if file_id else 0       # solo lo nuevo desde que se abre la sesión
    while True:
        # Carpeta recreada (reinicio de Escudo): la vigilancia anterior ya no avisa → se vuelve a crear
        if ident(DIR) != dir_id and os.path.isdir(DIR):
            if fd is not None:
                os.close(fd)
            fd, dir_id = inotify(DIR), ident(DIR)
        cur = ident(PATH)
        if cur != file_id:
            file_id, pos = cur, 0                       # archivo nuevo: desde el principio
        try:
            size = os.path.getsize(PATH)
        except OSError:
            size = 0
        if size < pos:
            pos = 0                                     # truncado
        if size > pos:
            with open(PATH, "rb") as fh:
                fh.seek(pos)
                for raw in fh:
                    if not raw.endswith(b"\n"):
                        break                           # línea a medio escribir: se lee en el próximo aviso
                    notify(raw.decode("utf-8", "replace"))
                    pos += len(raw)
        if fd is None:
            time.sleep(2)
            fd = inotify(DIR) if os.path.isdir(DIR) else None
            continue
        select.select([fd], [], [], 30)
        try:
            while os.read(fd, 4096):                    # vaciar los eventos acumulados
                pass
        except BlockingIOError:
            pass


main()
