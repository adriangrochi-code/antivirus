#!/bin/sh
# TISMA: si 4 minutos después de arrancar no hay pantalla de inicio de sesión ni escritorio, enseña EN PANTALLA qué
# falló (con el arranque silencioso no se vería nada: solo un cursor). Así se puede hacer una foto y arreglarlo.
sleep 240
loginctl list-sessions --no-legend 2>/dev/null | grep -q "seat0" && exit 0
systemctl is-active -q display-manager && \
    loginctl list-sessions --no-legend 2>/dev/null | grep -qE "greeter|sddm" && exit 0
T=/dev/tty1
chvt 1 2>/dev/null
{
    printf '\n\033[1;33m  TISMA no pudo mostrar la pantalla de inicio de sesión.\033[0m\n'
    printf '  Haz una foto de esta pantalla y envíala para que lo podamos arreglar.\n\n'
    printf '  Servicios con fallos:\n'
    systemctl --failed --no-legend --plain 2>/dev/null | cut -c1-100 | sed 's/^/    /' | head -12
    printf '\n  Pendientes:\n'
    systemctl list-jobs --no-legend 2>/dev/null | cut -c1-100 | sed 's/^/    /' | head -8
    printf '\n  Últimos errores:\n'
    journalctl -b -p err -n 18 --no-pager -o short-monotonic 2>/dev/null | cut -c1-118 | sed 's/^/  /'
    printf '\n  Para entrar en modo texto: Ctrl+Alt+F2.\n'
} > "$T" 2>/dev/null
exit 0
