#!/usr/bin/python3 -I
"""Precarga que aprende (como «Prefetch»): adelanta a la memoria las apps que ESTA persona usa de verdad.

Plasma ya anota qué apps abre cada uno y cuánto (base de kactivitymanagerd, la de «recientes» del menú). Al rato
de entrar, con el equipo libre y memoria de sobra, se leen por adelantado (posix_fadvise WILLNEED, sin ejecutar
nada) los programas y bibliotecas de las más usadas: abren mucho más rápido la primera vez. Solo archivos del
sistema (/usr, /opt), nunca documentos. Si falta memoria no hace nada.
"""
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys

DB = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                  "kactivitymanagerd/resources/database")
DIRS = [os.path.expanduser("~/.local/share/applications"), "/usr/local/share/applications",
        "/usr/share/applications", "/var/lib/flatpak/exports/share/applications"]
MAX_APPS = 8
# Lanzadores que son envoltorios: el programa real que conviene precargar
ENVOLTORIOS = {
    "tisma-sandbox": ["/usr/lib/chromium/chromium"],          # TISMA Navegador
    "chromium": ["/usr/lib/chromium/chromium"],
    "libreoffice": ["/usr/lib/libreoffice/program/soffice.bin"],
    "soffice": ["/usr/lib/libreoffice/program/soffice.bin"],
    "tisma-code": ["/usr/bin/python3"], "tisma-guia": ["/usr/bin/python3"],
    "tisma-seguridad-panel": ["/usr/bin/python3"],
}
SEGUROS = ("/usr/", "/opt/")


def mas_usadas(db: str = DB, n: int = MAX_APPS) -> list[str]:
    """IDs .desktop de las apps más usadas por esta persona (de más a menos)."""
    if not os.path.isfile(db):
        return []
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
        filas = con.execute("SELECT targettedResource, MAX(cachedScore) s FROM ResourceScoreCache "
                            "WHERE targettedResource LIKE 'applications:%' GROUP BY targettedResource "
                            "ORDER BY s DESC LIMIT ?", (n,)).fetchall()
        con.close()
    except sqlite3.Error:
        return []
    return [r[0].split(":", 1)[1] for r in filas if r[0].endswith(".desktop")]


def programa_de(desktop_id: str, dirs=DIRS) -> list[str]:
    """Ejecutables reales a precargar para ese lanzador."""
    for d in dirs:
        f = os.path.join(d, desktop_id)
        if os.path.isfile(f):
            texto = open(f, encoding="utf-8", errors="replace").read()
            m = re.search(r"(?m)^Exec=(.+)$", texto.split("\n[Desktop Action", 1)[0])
            if not m:
                return []
            try:
                partes = shlex.split(m.group(1))
            except ValueError:
                return []
            partes = [p for p in partes if not re.match(r"^[A-Z_]+=", p) and p != "env"]
            if not partes:
                return []
            nombre = os.path.basename(partes[0])
            if nombre in ENVOLTORIOS:
                return ENVOLTORIOS[nombre]
            ruta = shutil.which(partes[0]) or partes[0]
            return [os.path.realpath(ruta)] if os.path.isabs(ruta) else []
    return []


def bibliotecas(path: str) -> list[str]:
    try:
        out = subprocess.run(["ldd", path], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return re.findall(r"=> (/\S+)", out)


def memoria_libre_ratio() -> float:
    info = dict(re.findall(r"^(\w+):\s+(\d+)", open("/proc/meminfo").read(), re.M))
    return int(info["MemAvailable"]) / int(info["MemTotal"])


def calentar(path: str) -> int:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return 0
    try:
        tam = os.fstat(fd).st_size
        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_WILLNEED)
        return tam
    finally:
        os.close(fd)


def main() -> int:
    if memoria_libre_ratio() < 0.40:
        print("Poca memoria libre: no se precarga")
        return 0
    limite = int(dict(re.findall(r"^(\w+):\s+(\d+)", open("/proc/meminfo").read(), re.M))["MemAvailable"]) * 1024 // 4
    vistos, total = set(), 0
    for app in mas_usadas():
        for exe in programa_de(app):
            for f in [exe, *bibliotecas(exe)]:
                real = os.path.realpath(f)
                if real in vistos or not real.startswith(SEGUROS) or not os.path.isfile(real):
                    continue
                vistos.add(real)
                total += calentar(real)
                if total > limite:                    # como mucho 1/4 de la memoria libre
                    print(f"Precargados {len(vistos)} archivos ({total / 1e6:.0f} MB, límite)")
                    return 0
    print(f"Precargados {len(vistos)} archivos ({total / 1e6:.0f} MB)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
