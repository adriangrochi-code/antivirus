#!/usr/bin/python3 -I
"""TISMA: cambio rápido entre 5 GHz y 2,4 GHz (casas con las dos bandas).

* Con la MISMA red (mismo nombre en las dos bandas): si estás en 2,4 GHz y la de 5/6 GHz llega bien
  (≥ -67 dBm), se pasa a ella con «roam» de wpa_supplicant (no se reconecta: se conserva la IP y las
  descargas siguen). Si estás en 5 GHz y la señal cae mucho (≤ -78 dBm) y la de 2,4 GHz llega claramente mejor,
  se vuelve a 2,4 GHz antes de que la conexión se corte.
* Con dos redes («Casa» y «Casa-5G», guardadas ambas en NetworkManager): mismo criterio, cambiando de
  conexión (tarda 1-3 s porque hay que volver a asociarse y pedir IP).
Con histéresis: la condición debe mantenerse en dos comprobaciones seguidas y nunca se cambia más de una vez
cada 90 s. Desactivable con ACTIVO=no en /etc/tisma/wifi-banda.conf (PARES=Casa:Casa-5G para pares con
nombres que no siguen el patrón -5G/_5G/5GHz).
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
import time

CONF = "/etc/tisma/wifi-banda.conf"
GOOD_5G, BAD_5G, MARGIN = -67, -78, 8
MIN_GAP_S, POLL_S = 90, 10
SUFFIX = re.compile(r"[-_ ]?(5G|5GHz|5Ghz|5g|5ghz)$")


def sh(argv: list[str]) -> str:
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def band(freq: int) -> str:
    return "2.4" if freq < 3000 else "5+"


def parse_link(out: str) -> dict | None:
    m = re.search(r"Connected to ([0-9a-f:]{17})", out)
    if not m:
        return None
    ssid = re.search(r"^\s*SSID: (.*)$", out, re.M)
    freq = re.search(r"freq: (\d+)", out)
    sig = re.search(r"signal: (-?\d+)", out)
    return {"bssid": m.group(1), "ssid": ssid.group(1) if ssid else "", "freq": int(freq.group(1)) if freq else 0,
            "signal": int(sig.group(1)) if sig else -100}


def parse_scan(out: str) -> list[dict]:
    res = []
    for blk in re.split(r"^BSS ", out, flags=re.M)[1:]:
        bssid = blk[:17]
        freq = re.search(r"freq: (\d+)", blk)
        sig = re.search(r"signal: (-?[\d.]+) dBm", blk)
        ssid = re.search(r"^\s*SSID: (.*)$", blk, re.M)
        last = re.search(r"last seen: (\d+) ms ago", blk)
        if freq and sig and ssid:
            res.append({"bssid": bssid, "freq": int(freq.group(1)), "signal": float(sig.group(1)),
                        "ssid": ssid.group(1), "age_ms": int(last.group(1)) if last else 0})
    return res


def conf(path: str = CONF) -> tuple[bool, dict[str, str]]:
    active, pairs = True, {}
    try:
        for line in open(path, encoding="utf-8"):
            k, _, v = line.strip().partition("=")
            if k == "ACTIVO" and v.lower() in ("no", "0"):
                active = False
            if k == "PARES":
                for p in v.split(","):
                    a, _, b = p.partition(":")
                    if a and b:
                        pairs[a.strip()] = b.strip()
                        pairs[b.strip()] = a.strip()
    except OSError:
        pass
    return active, pairs


def related(a: str, b: str, pairs: dict[str, str]) -> bool:
    """Misma red, o par 2,4/5 GHz: por configuración o por el patrón «Casa» / «Casa-5G»."""
    return a == b or pairs.get(a) == b or (bool(a) and SUFFIX.sub("", a) == SUFFIX.sub("", b))


def decide(cur: dict, scan: list[dict], pairs: dict[str, str]) -> dict | None:
    """Candidato al que cambiar, o None."""
    cands = [b for b in scan if b["bssid"] != cur["bssid"] and related(cur["ssid"], b["ssid"], pairs)
             and b["age_ms"] < 120_000]
    if band(cur["freq"]) == "2.4":
        best = max((b for b in cands if band(b["freq"]) == "5+"), key=lambda b: b["signal"], default=None)
        if best and best["signal"] >= GOOD_5G:
            return best
    elif cur["signal"] <= BAD_5G:
        best = max((b for b in cands if band(b["freq"]) == "2.4"), key=lambda b: b["signal"], default=None)
        if best and best["signal"] >= cur["signal"] + MARGIN:
            return best
    return None


class Steer:
    def __init__(self, dev: str, run=sh, now=time.monotonic):
        self.dev, self.run, self.now = dev, run, now
        self.pending: str | None = None
        self.last_switch = -1e9
        self.last_scan = -1e9

    def connection_for(self, ssid: str) -> str | None:
        for line in self.run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"]).splitlines():
            name, _, typ = line.rpartition(":")
            if typ == "802-11-wireless":
                name = name.replace("\\:", ":")
                if self.run(["nmcli", "-g", "802-11-wireless.ssid", "connection", "show", name]).strip() == ssid:
                    return name
        return None

    def switch(self, cur: dict, target: dict) -> str:
        if target["ssid"] == cur["ssid"]:
            how = "roam"
            if self.run(["wpa_cli", "-i", self.dev, "roam", target["bssid"]]).strip() != "OK":
                # Sin interfaz de control de wpa_supplicant: NetworkManager reconecta a ese punto de acceso
                name = self.connection_for(cur["ssid"])
                if not name:
                    return "no se pudo cambiar de banda"
                self.run(["nmcli", "--wait", "15", "connection", "up", "id", name, "ifname", self.dev,
                          "ap", target["bssid"]])
                how = f"conexión {name}"
        else:
            name = self.connection_for(target["ssid"])
            if not name:
                return f"sin conexión guardada para «{target['ssid']}»"
            self.run(["nmcli", "--wait", "15", "connection", "up", "id", name, "ifname", self.dev])
            how = f"conexión {name}"
        self.last_switch = self.now()
        return (f"{cur['ssid']} {band(cur['freq'])} GHz ({cur['signal']} dBm) → {target['ssid']} "
                f"{band(target['freq'])} GHz ({target['signal']:.0f} dBm) por {how}")

    def step(self, pairs: dict[str, str] | None = None) -> str | None:
        cur = parse_link(self.run(["iw", "dev", self.dev, "link"]))
        if not cur:
            self.pending = None
            return None
        # En 2,4 GHz, un escaneo cada 2 min para ver si llega la de 5 GHz (en 5 GHz no se escanea: sin cortes)
        if band(cur["freq"]) == "2.4" and self.now() - self.last_scan > 120:
            self.run(["iw", "dev", self.dev, "scan", "trigger"])
            self.last_scan = self.now()
        target = decide(cur, parse_scan(self.run(["iw", "dev", self.dev, "scan", "dump"])), pairs or {})
        if not target:
            self.pending = None
            return None
        if self.pending != target["bssid"]:
            self.pending = target["bssid"]             # primera vez: esperar a confirmarlo
            return None
        if self.now() - self.last_switch < MIN_GAP_S:
            return None
        self.pending = None
        return self.switch(cur, target)


def main() -> int:
    steers: dict[str, Steer] = {}
    while True:
        active, pairs = conf()
        if active:
            for w in os.listdir("/sys/class/net"):
                if os.path.isdir(f"/sys/class/net/{w}/wireless"):
                    msg = steers.setdefault(w, Steer(w)).step(pairs)
                    if msg:
                        print(f"tisma-wifi-banda: {msg}", flush=True)
        time.sleep(POLL_S)


if __name__ == "__main__" and os.environ.get("TISMA_TEST") != "1":
    sys.exit(main())
