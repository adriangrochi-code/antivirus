#!/bin/sh
# Ahorro de energía del Wi-Fi según la alimentación: enchufado = desactivado (el modo ahorro añade latencia
# de decenas a cientos de ms a cada petición, y una página hace decenas), con batería = activado.
# Lo llaman udev (al enchufar/desenchufar) y NetworkManager (al conectar). Uso: wifi-ahorro [iface acción]
ac=0
for s in /sys/class/power_supply/*; do
    [ "$(cat "$s/type" 2>/dev/null)" = "Mains" ] && [ "$(cat "$s/online" 2>/dev/null)" = "1" ] && ac=1
done
# Sin batería (equipo de sobremesa): siempre desactivado
ls /sys/class/power_supply/BAT* >/dev/null 2>&1 || ac=1
mode=on
[ "$ac" = 1 ] && mode=off
for w in /sys/class/net/*/wireless; do
    [ -d "$w" ] || continue
    dev=$(basename "$(dirname "$w")")
    /usr/sbin/iw dev "$dev" set power_save "$mode" 2>/dev/null || true
done
exit 0
