#!/bin/sh
# Reglas de auditd por usuario (uid >= 1000): secretos, datos del navegador y persistencia.
# Corre como root sobre carpetas de los usuarios: NO crea ni modifica nada en ellas y se salta
# los enlaces simbólicos (un usuario podría apuntar ~/.config a /etc).
set -u
command -v auditctl >/dev/null || exit 0

# La ruta real (todos los enlaces resueltos) debe ser la misma que la pedida: así ningún componente intermedio
# (~/.config, ~/.local…) puede ser un enlace a /etc u otra carpeta del sistema.
real_igual() { [ "$(realpath -e -- "$1" 2>/dev/null)" = "$1" ]; }

vigilar() { # ruta permisos clave
    if [ -e "$1" ] && real_igual "$1"; then
        auditctl -w "$1" -p "$2" -k "$3" 2>/dev/null || true
    fi
}

getent passwd | while IFS=: read -r _ _ uid _ _ home _; do
    if [ "$uid" -lt 1000 ] || [ "$uid" -ge 60000 ] || [ ! -d "$home" ] || ! real_igual "$home"; then
        continue
    fi
    for d in .ssh .gnupg .local/share/keyrings; do vigilar "$home/$d" r secretos; done
    for d in .config/chromium .mozilla/firefox; do vigilar "$home/$d" r navegador; done
    # Objetivos habituales de los ladrones de información: carteras, mensajería y claves locales
    for d in .electrum .bitcoin/wallets .config/Exodus .config/discord ".local/share/TelegramDesktop/tdata" \
             .config/tisma-code .aws .config/gcloud .kube .docker; do
        vigilar "$home/$d" r secretos
    done
    # Ejecutar algo directamente desde Descargas (adjuntos, «cracks»)
    for d in Descargas Downloads; do
        if [ -d "$home/$d" ] && real_igual "$home/$d"; then
            auditctl -a always,exit -F arch=b64 -S execve,execveat -F dir="$home/$d" -k exec_tmp 2>/dev/null || true
        fi
    done
    for d in .config/autostart .config/systemd/user .local/share/systemd/user .bashrc .profile \
             .bash_profile .zshrc .pam_environment; do
        vigilar "$home/$d" wa persistencia
    done
done
