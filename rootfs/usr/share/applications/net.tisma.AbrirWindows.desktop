[Desktop Entry]
Type=Application
Name=Programa .exe (revisado por Escudo)
Comment=Abre programas .exe e instaladores .msi aislados, después de que Escudo los revise
Exec=tisma-abrir-windows %f
Icon=wine
NoDisplay=true
Terminal=false
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-dosexec;application/x-msi;application/x-ms-installer;application/x-wine-extension-msp;
