// La sesión local activa puede iniciar (solo iniciar) la fase 2 del arranque
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.local && subject.active &&
        action.lookup("unit") == "tisma-fase2.target" && action.lookup("verb") == "start") {
        return polkit.Result.YES;
    }
});
