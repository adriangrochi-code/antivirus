<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>TISMA OS</vendor>
  <action id="org.tisma.actualizar-instalado">
    <description>Actualizar el TISMA instalado desde el USB</description>
    <message>Actualizar el sistema instalado requiere autenticación de administrador</message>
    <icon_name>tisma</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tisma/actualizar-instalado</annotate>
  </action>
</policyconfig>
