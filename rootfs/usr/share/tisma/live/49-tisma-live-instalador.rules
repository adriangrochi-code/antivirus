// TISMA (solo sesión live; lo copia tisma-live-instalador.service): el instalador se abre sin pedir contraseña.
// También «Actualizar TISMA» (actualiza el sistema instalado; pide la contraseña del disco). En la sesión live el
// usuario «tisma» ya es administrador sin contraseña: no añade ningún permiso.
polkit.addRule(function(action, subject) {
    if ((action.id == "com.github.calamares.calamares.pkexec.run" ||
         action.id == "org.tisma.actualizar-instalado") &&
        subject.user == "tisma" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
