/*--------------------------------*- C++ -*----------------------------------*\\
  Plantilla TISMA: cavidad con tapa móvil (icoFoam, flujo laminar 2D, Re = U*L/nu = 1*0.1/0.01 = 10)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     icoFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.5;
deltaT          0.005;
writeControl    timeStep;
writeInterval   20;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
